name: 生成并提交 package-lock.json

on:
  workflow_dispatch:  # 允许你手动触发这个工作流

jobs:
  generate-lock:
    runs-on: ubuntu-latest
    steps:
      - name: 1. 拉取代码
        uses: actions/checkout@v4

      - name: 2. 设置 Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 24

      - name: 3. 生成完整的 package-lock.json
        run: |
          # 执行 npm install，这会自动生成完整的 lock 文件
          npm install
          # 显示生成的文件大小，确认它包含完整依赖
          wc -l package-lock.json

      - name: 4. 提交并推送生成的文件回仓库
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add package-lock.json
          # 检查文件是否被添加，如果有变更则提交
          if git status --porcelain | grep -q "package-lock.json"; then
            git commit -m "🤖 [bot] 自动生成完整的 package-lock.json"
            git push
          else
            echo "没有新的变更需要提交。"
          fi
